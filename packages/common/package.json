{
  "name": "@tidal-music/common",
  "version": "0.2.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:tidal-music/tidal-sdk-web.git"
  },
  "license": "Apache-2.0",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "scripts": {
    "prepare": "vite build",
    "build": "vite build",
    "build:dev": "vite build -m development",
    "clean": "rm -rf coverage dist .eslintcache",
    "dev": "vite --debug --cors -c=./vite.config.ts",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:ci": "eslint . --quiet",
    "lint:fix": "pnpm run lint --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "pnpm run test --coverage",
    "test:ui": "pnpm run test:coverage --ui",
    "typecheck": "tsc && tsc -p tsconfig.build.json",
    "check:types-resolution": "attw --pack . --ignore-rules=cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vitest": "5.0.0"
  }
}
